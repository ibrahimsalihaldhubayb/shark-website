rules_version = '2';

// قواعد قاعدة بيانات شارك العقارية (Firestore)
// الصقها في: Firebase Console ← Firestore Database ← Rules ← Publish
//
// ملاحظة: لوحة الإدارة تسجّل الدخول بنظامها الخاص (وليس Firebase Authentication)،
// لذلك تصل طلباتها لقاعدة البيانات كزائر مجهول. هذه القواعد تُبقي الموقع ولوحة الإدارة
// تعمل بدون تاريخ انتهاء، وتسمح فقط بالمجموعات التي يستخدمها الموقع وترفض أي شيء آخر.
// الحماية الكاملة تحتاج ربط لوحة الإدارة بـ Firebase Authentication (خطوة لاحقة).

service cloud.firestore {
  match /databases/{database}/documents {

    // للعرض العام في الموقع (قراءة للجميع) + تعديل من لوحة الإدارة
    match /offers/{id}        { allow read, write: if true; }
    match /projects/{id}      { allow read, write: if true; }
    match /project_media/{id} { allow read, write: if true; }
    match /promos/{id}        { allow read, write: if true; }
    match /config/{id}        { allow read, write: if true; }

    // العملاء: نماذج الموقع تضيف، ولوحة الإدارة تقرأ وتعدّل
    match /clients/{id}       { allow read, write: if true; }
    match /requests/{id}      { allow read, write: if true; }

    // بيانات لوحة الإدارة الداخلية
    match /offer_notes/{id}     { allow read, write: if true; }
    match /offer_docs/{id}      { allow read, write: if true; }
    match /tasks/{id}           { allow read, write: if true; }
    match /finance/{id}         { allow read, write: if true; }
    match /deals/{id}           { allow read, write: if true; }
    match /employees/{id}       { allow read, write: if true; }
    match /employee_ledger/{id} { allow read, write: if true; }
    match /messages/{id}        { allow read, write: if true; }
    match /meetings/{id}        { allow read, write: if true; }

    // أي مجموعة غير مذكورة أعلاه: مرفوضة
    match /{document=**} { allow read, write: if false; }
  }
}
